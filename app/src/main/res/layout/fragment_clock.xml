<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linear"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:theme="@style/ThemeOverlay.SoraDisplay.FullscreenContainer"
    tools:context=".natureremo.ClockFragment">

    <!-- Sensor Data Card -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/weather_item_glass_bg"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/sensorTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="24.5°" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:alpha="0.2"
            android:background="@color/white" />

        <TextView
            android:id="@+id/sensorHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_blue_400"
            android:textSize="32sp"
            tools:text="50%" />

    </LinearLayout>

    <TextView
        android:id="@+id/remoLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.7"
        android:textColor="@color/white"
        android:textSize="18sp"
        tools:text="Living Room" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/textDateDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/white"
        android:alpha="0.8"
        android:textSize="40sp"
        tools:text="Monday, Oct 23" />

    <org.sorakun.soradisplay.natureremo.SoraDigitalClock
        android:id="@+id/simpleDigitalClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layerType="software"
        android:textColor="@color/white"
        android:textSize="160sp"
        android:textStyle="bold"
        tools:text="12:00" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

</LinearLayout>
